            android:fillColor="#00000000" />
        <!-- glowing orb -->
        <path android:pathData="M54,19 A35,35 0 1,1 53.9,19 Z">
            <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
                <gradient android:type="radial" android:centerX="50" android:centerY="42" android:gradientRadius="56">
                    <item android:offset="0" android:color="#FFFB7185" />
                    <item android:offset="0.55" android:color="#FFE11D48" />
                    <item android:offset="1" android:color="#FF701A75" />
                </gradient>
            </aapt:attr>
        </path>
        <!-- scythe blade sweep -->
        <path
            android:pathData="M21,67 C29,42 52,25 87,25 C70,33 57,44 49,58 C43,68 35,73 21,67 Z"
            android:fillColor="#F8FAFC"
            android:fillAlpha="0.95" />
        <!-- blade edge accent -->
        <path
            android:pathData="M26,65 C34,46 54,31 83,28 C64,35 51,46 44,59 C40,66 32,69 26,65 Z"
            android:fillColor="#1E1B2E"
            android:fillAlpha="0.32" />
