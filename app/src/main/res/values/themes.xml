<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ShiStart" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#0D0D12</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.ShiMain</item>
    </style>
    <style name="Theme.ShiMain" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0D0D12</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
