    <!-- ============ Onboarding ============ -->
    <string name="ob_welcome_title">Meet Shini</string>
    <string name="ob_welcome_body">Your assistant, your rules. Shini runs entirely on your device — you decide which AI provider to connect, which permissions to grant, and nothing more.</string>
    <string name="ob_capability_title">What can Shini do?</string>
    <string name="ob_capability_body">Open apps, set alarms and timers, control media and volume, toggle the flashlight, call contacts, search the web — all offline. Connect an AI provider and Shini can also hold real conversations and handle complex requests.</string>
    <string name="ob_privacy_title">Privacy first</string>
    <string name="ob_privacy_body">No account. No telemetry. Secrets are encrypted with your device keystore. The AI never acts alone — every action is validated locally before your phone executes it.</string>
    <string name="ob_choice_title">How do you want to start?</string>
    <string name="ob_choice_offline_title">Start offline</string>
    <string name="ob_choice_offline_body">Basic commands work instantly, no API key needed.</string>
    <string name="ob_choice_provider_title">Connect an AI</string>
    <string name="ob_choice_provider_body">Bring your own key — OpenAI, Gemini, Mistral, GLM or any OpenAI-compatible endpoint.</string>
    <string name="ob_voice_title">Voice</string>
    <string name="ob_voice_body">Shini uses your Android speech recognition and text-to-speech. You can change engine, language, speed and pitch anytime.</string>
    <string name="ob_permissions_title">Permissions</string>
    <string name="ob_permissions_body">Shini asks only for what a feature needs, when it needs it. You can review everything on the Permission Dashboard.</string>
    <string name="ob_finish_title">You are ready</string>
    <string name="ob_finish_body">Say “Hey Shini” — or tap the orb — and see what happens.</string>
    <string name="ob_next">Next</string>
    <string name="ob_back">Back</string>
    <string name="ob_skip">Skip</string>
    <string name="ob_get_started">Get started</string>

